# =============================================================================
# ops-center 运维中台 - 环境变量模板
# 用法：cp .env.example .env 然后按实际情况修改
# 注意：.env 已在 .gitignore 中，绝不会提交到 git
# =============================================================================

# ---------- 服务 ----------
# 监听地址与端口
OPS_HOST=0.0.0.0
OPS_PORT=8000
# 调试模式（生产务必 false）
OPS_DEBUG=false

# ---------- 数据库（MySQL / 云上 RDS 同一套连接串，换地址即可） ----------
# 连接串格式：mysql+pymysql://用户:密码@地址:3306/库名?charset=utf8mb4
#   · 本机 Docker 测试：用默认 127.0.0.1 即可（./deploy.sh mysql-up 会自动起，并把本行连接串自动写入 .env）
#   · 云服务器 + 云上 RDS：把地址换成 RDS 内网/外网地址即可，例如
#     OPS_DATABASE_URL="mysql+pymysql://opscenter:改密码@rm-xxxx.mysql.rds.aliyuncs.com:3306/ops_center?charset=utf8mb4"
#     同 VPC 用内网地址（免流量费）；跨环境访问需在 RDS 白名单放行来源 IP。
OPS_DATABASE_URL="mysql+pymysql://opscenter:opscenter123@127.0.0.1:3306/ops_center?charset=utf8mb4"
# SQLite（本机快速体验 / 无 MySQL 环境时使用，取消下行注释并注释上面一行即可）
# OPS_DATABASE_URL=sqlite:///./data/ops_center.db

# ---------- 安全 ----------
# JWT 签名密钥，务必修改为随机字符串（可用 openssl rand -hex 32 生成）
OPS_SECRET_KEY=please-change-this-to-a-random-32-bytes-string
# Token 有效期（小时）
OPS_TOKEN_EXPIRE_HOURS=12
# 云账号 AK/SK 加密主密钥（留空则自动生成并写入 data/secret.key）
OPS_FERNET_KEY=

# ---------- 初始管理员 ----------
# 仅首次初始化数据库时生效
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=Admin@12345

# ---------- 调度与同步 ----------
# 资源自动同步 cron（默认每天 8:30）
OPS_SYNC_CRON="30 8 * * *"
# 开机后等待资源就绪的超时时间（秒）
OPS_OP_TIMEOUT=600
# 单个云 API 调用的并发上限
OPS_MAX_WORKERS=8

# ---------- 部署 / 镜像加速 ----------
# Docker 镜像加速器地址（阿里云 ECS 强烈推荐：免登录、同地域走内网更快且免流量费）
#   获取：阿里云控制台 → 容器镜像服务 ACR → 左侧「镜像加速器」→ 复制地址
#   示例：DOCKER_REGISTRY_MIRROR=https://xxxxxx.mirror.aliyuncs.com
#   配置后 ./deploy.sh mysql-up 会自动写入 /etc/docker/daemon.json 的 registry-mirrors 并重启 docker，
#   之后 mysql:8.0 经阿里云加速拉取；也可命令行临时覆盖：DOCKER_REGISTRY_MIRROR=xxx ./deploy.sh mysql-up
#   留空则使用默认国内源（华为云 SWR 公开代理），无需配置即可拉取
DOCKER_REGISTRY_MIRROR=
